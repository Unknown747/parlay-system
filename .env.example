# ============================================
# .env.example — Konfigurasi Parlay System
# Duplikasi jadi .env dan isi dengan data Anda
# ============================================

# ===== API KEYS (Rotasi) =====
# Gunakan koma untuk multiple keys: key1,key2,key3
# System akan otomatis rotate kalau kena rate limit (429)

# OpenFootball API (untuk fixtures hari ini)
# https://openfootapi.com
OPENFOOT_API_KEYS=your_openfoot_key1,your_openfoot_key2

# The Odds API (untuk odds/kemenangan)
# https://the-odds-api.com
ODDS_API_KEYS=your_odds_key1,your_odds_key2

# Legacy fallback (jika hanya 1 key)
API_KEY=your_openfoot_key
ODDS_API_KEY=your_odds_key
API_BASE_URL=https://api.openfootapi.com/v1

# ===== LIGA & MUSIM =====
# Koma-separated list
LEAGUES=EPL,LaLiga,SerieA,Bundesliga,Ligue1,Eredivisie,PrimeiraLiga,Championship
SEASONS=2021,2022,2023,2024,2025

# ===== O/U LINES =====
# Over/Under thresholds yang dianalisis
OU_LINES=1.5,2.5,3.5

# ===== CONFIDENCE & VALUE FILTER =====
MIN_CONFIDENCE=0.55
MIN_VALUE=0.03

# ===== TIER CONFIGURATION =====
# Tier S = High confidence + value
TIER_S_CONF=0.72
TIER_S_VALUE=0.10
TIER_S_SKOR=0.48
STAKE_S=10000

# Tier A = Medium-high
TIER_A_CONF=0.65
TIER_A_VALUE=0.06
TIER_A_SKOR=0.40
STAKE_A=10000

# Tier B = Medium
TIER_B_CONF=0.55
TIER_B_VALUE=0.03
TIER_B_SKOR=0.30
STAKE_B=10000

# ===== STAKE LIMIT =====
MAX_DAILY_STAKE=100000

# ===== TELEGRAM NOTIFICATION =====
# Opsional: kirim hasil prediksi ke Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== DATABASE & CACHE =====
DB_PATH=data/processed/matches_normalized.csv
CACHE_DIR=data/raw/cache

# ===== SKOR WEIGHTING =====
# Bobot untuk menghitung skor komposit
SKOR_BOBOT_CONF=0.6
SKOR_BOBOT_VALUE=0.4

# ===== APIFY (Opsional) =====
# Untuk scraping jika butuh data lebih (opsional)
APIFY_TOKEN=your_apify_token

# ===== LOG & DEBUG =====
DEBUG=False
LOG_LEVEL=INFO

# ===== FLEXIBLE UPDATE WORKFLOW =====
# Jika True, fetch odds dari API. Jika False, hanya pakai cache
FETCH_ODDS_API=True

# Jika True, cache odds tidak pernah expired (cocok untuk update 1x sebulan)
USE_PERMANENT_ODDS_CACHE=False

# Jika True, allow manual fixtures backfill dari data/raw/manual_fixtures.csv
ALLOW_MANUAL_FIXTURES=True

# Jika True, allow manual bets input dari data/raw/manual_bets.csv
ALLOW_MANUAL_BETS=True

# Jika True, append tracking bukan overwrite
APPEND_TRACKING=True
